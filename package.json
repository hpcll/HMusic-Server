{
  "name": "hmusic-server",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "HMusic Server - self-hosted backend for HMusic.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:deploy": "bash test/deployment-scripts.sh",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "verify:release": "bash scripts/verify-public-release.sh",
    "lint": "eslint src test",
    "format": "prettier --write src test"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.2.1",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "bonjour-service": "^1.4.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.0",
    "music-metadata": "^11.14.0",
    "nanoid": "^5.0.9",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "qrcode-generator": "^2.0.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.39"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
