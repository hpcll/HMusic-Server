HMUSIC_HOST=0.0.0.0
HMUSIC_PORT=6650
HMUSIC_DATA_DIR=./data
HMUSIC_DATABASE_URL=./data/hmusic.db
HMUSIC_JWT_SECRET=change-me
# App 一键升级令牌（Docker 部署用，install.sh 自动生成随机值；native 部署可留空）
HMUSIC_UPDATE_TOKEN=
HMUSIC_LOG_LEVEL=info
# Docker Compose 数据卷权限；install.sh 会按宿主机 data/ 目录自动填写。
HMUSIC_DOCKER_UID=0
HMUSIC_DOCKER_GID=0
# 端口必须与 HMUSIC_PORT 一致：这是下发给小爱音箱的音频地址所用端口。
# 局域网 IPv4 会自动探测替换 127.0.0.1，换端口时只需保证这里的端口与上面对齐。
HMUSIC_PUBLIC_BASE_URL=http://127.0.0.1:6650
